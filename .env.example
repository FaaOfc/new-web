# ============================================
# TaoSite — Environment Variables (OPSIONAL)
# ============================================
# Semua variable di bawah ini OPSIONAL.
# Fitur downloader (54 engine) jalan TANPA env apa pun.
# Env hanya dibutuhkan untuk fitur CDN & ShortURL.

# Token GitHub dengan scope repo + gist
# Buat di: https://github.com/settings/tokens
GITHUB_TOKEN=

# Username GitHub kamu (pemilik repo CDN)
GITHUB_USER=

# Nama repo GitHub untuk menyimpan file CDN (private/public)
CDN_REPO=

# ID Gist untuk menyimpan mapping short URL (isi gist dengan "{}")
GIST_ID=

# Domain produksi untuk output link short URL
APP_DOMAIN=https://taosite.my.id

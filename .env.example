# ============================================================
# TaoSite — Contoh Environment Variables
# Salin file ini menjadi .env lalu isi nilainya.
# ============================================================

# --- Database (autentikasi user) ---
DATABASE_URL=postgresql://user:password@host:5432/taosite

# --- CDN & ShortURL (GitHub backend) ---
# Token GitHub dengan akses repo CDN + gist
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Username GitHub pemilik repo CDN
GITHUB_USER=usernamekamu
# Nama repo yang dipakai sebagai penyimpanan CDN
CDN_REPO=cdn
# ID Gist untuk database URL pendek
GIST_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Domain publik (opsional) ---
APP_DOMAIN=https://taosite.my.id
